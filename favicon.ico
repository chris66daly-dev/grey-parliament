@import url('https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;500;700&family=Source+Sans+3:wght@300;400;500;600&display=swap');

@tailwind base;
@tailwind components;
@tailwind utilities;

:root {
  --ink: #1a1814;
  --stone: #f5f3ee;
  --warm: #e8e4dc;
  --mid: #c8c4bc;
  --grey: #888074;
  --accent: #2c2c2a;
  --gold: #b8a882;
  --serif: 'Playfair Display', Georgia, serif;
  --sans: 'Source Sans 3', system-ui, sans-serif;
}

* { box-sizing: border-box; }

body {
  font-family: var(--sans);
  background: var(--stone);
  color: var(--ink);
  -webkit-font-smoothing: antialiased;
}

.font-serif { font-family: var(--serif) !important; }

.rule-line {
  display: flex;
  align-items: center;
  gap: 12px;
}
.rule-line::before,
.rule-line::after {
  content: '';
  flex: 1;
  height: 1px;
  background: var(--ink);
}

@keyframes fadeIn {
  from { opacity: 0; transform: translateY(8px); }
  to   { opacity: 1; transform: translateY(0); }
}
.fade-in { animation: fadeIn 0.4s ease forwards; }

@keyframes pulse {
  0%, 100% { opacity: 1; }
  50%       { opacity: 0.4; }
}
.pulse { animation: pulse 2s infinite; }

.vote-bar { transition: width 0.8s ease; }
